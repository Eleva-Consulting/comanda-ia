# Copie este arquivo para ".env" e preencha com os valores reais antes de rodar o agente.
# Nunca commite o arquivo ".env" de verdade (contém um segredo do estabelecimento).

# URL do backend do comanda-ia. Produção (padrão, pode deixar em branco/comentado) ou
# homologação, se estiver testando.
# BACKEND_URL=https://comanda-ia-production.up.railway.app

# ID do estabelecimento e token do agente — gerados em Configurações → Agente de impressão
# local, no painel do restaurante (o token só é exibido uma vez, na hora de gerar).
ESTABELECIMENTO_ID=
DEVICE_TOKEN=
